{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "trailingSlash": false,
  "regions": ["gru1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/agendamento", "destination": "/index.html" },
    { "source": "/cortes", "destination": "/index.html" },
    { "source": "/galeria", "destination": "/index.html" },
    { "source": "/contato", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
